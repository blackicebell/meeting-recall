{
  "expo": {
    "name": "Meeting Recall",
    "slug": "meeting-recall",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "meetingrecall",
    "icon": "./assets/icons/app-icon-placeholder.png",
    "splash": {
      "image": "./assets/splash/splash-placeholder.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.meetingrecall.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone access is needed to record your meetings."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground-placeholder.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.meetingrecall.app"
    },
    "extra": {
      "eas": {
        "projectId": "3fb21c67-5c66-4c0c-854b-da4a9ca50ddf"
      }
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ]
    ]
  }
}
