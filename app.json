{
  "expo": {
    "name": "Meeting Recall",
    "slug": "meeting-recall",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "meetingrecall",
    "icon": "./assets/icons/app-icon.png",
    "splash": {
      "image": "./assets/splash/splash.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "2",
      "bundleIdentifier": "com.meetingrecall.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Meeting Recall uses the microphone to record your meetings.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "backgroundColor": "#202020"
      },
      "package": "com.meetingrecall.app",
      "versionCode": 1
    },
    "extra": {
      "eas": {
        "projectId": "3fb21c67-5c66-4c0c-854b-da4a9ca50ddf"
      }
    }
  }
}
